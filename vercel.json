{
  "rewrites": [
    {
      "source": "/",
      "destination": "/神秘占卜网页（5-16）.html"
    }
  ],
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(favicon.ico|favicon.png|icon-192.png|icon-512.png|assets/(favicon.png|favicon-32.png|apple-touch-icon.png|pwa/.*))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
